# Example override: copy to docker-compose.override.yml to use your host's
# Ollama instead of the containerised one.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Compose auto-loads docker-compose.override.yml; the .example variant is
# committed so this pattern is discoverable. The actual override file is
# gitignored.
#
# Strategy: Compose merges depends_on additively, so we cannot simply remove
# the ollama/ollama-init dependencies from the gateway. Instead we replace
# both services with tiny alpine stubs that satisfy their health/completion
# conditions immediately, then redirect the gateway at the host's Ollama.

services:
  # Stub that satisfies `condition: service_healthy` immediately.
  ollama:
    image: alpine:3.20
    command: ["sh", "-c", "while true; do sleep 3600; done"]
    healthcheck:
      test: ["CMD", "true"]
      interval: 1s
      timeout: 1s
      retries: 1
      start_period: 0s
    restart: "no"

  # Stub that satisfies `condition: service_completed_successfully` immediately.
  ollama-init:
    image: alpine:3.20
    command: ["true"]
    restart: "no"

  gateway:
    environment:
      # On macOS/Windows (Docker Desktop, Colima, OrbStack) the host is
      # reachable via host.docker.internal. On Linux you may need to add:
      #   extra_hosts:
      #     - "host.docker.internal:host-gateway"
      GATEWAY_OLLAMA_BASE_URL: http://host.docker.internal:11434
