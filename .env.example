# Host and port are uvicorn flags (--host, --port), not gateway settings.
GATEWAY_LOG_LEVEL=INFO

# ── Ollama ──────────────────────────────────────────────────────────────────
# When running on the host, http://localhost:11434
# Inside docker-compose, the service hostname is `ollama`.
GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
GATEWAY_OLLAMA_TIMEOUT_S=120.0

# Model identifiers exposed to callers.
GATEWAY_MODEL_HIGH_QUALITY=qwen3.5:4b
GATEWAY_MODEL_BUDGET=qwen3.5:0.8b
GATEWAY_MODEL_EMBEDDINGS=qwen3-embedding:0.6b

# ── Redis (token bucket rate limiting) ──────────────────────────────────────
GATEWAY_REDIS_URL=redis://localhost:6379/0

# ── SQLite (cost ledger, circuit state) ─────────────────────────────────────
# Relative to cwd. Override with an absolute path for production.
GATEWAY_DB_PATH=data/gateway.db

# ── Auth ────────────────────────────────────────────────────────────────────
# Path to the YAML file of teams (see config/teams.example.yaml). Read at
# startup; PUT /v1/admin/teams/{id} changes teams in memory, not in this file.
GATEWAY_TEAMS_YAML=config/teams.yaml

# ── Circuit breaker ─────────────────────────────────────────────────────────
GATEWAY_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=0.5
GATEWAY_CIRCUIT_BREAKER_MIN_REQUESTS=10
GATEWAY_CIRCUIT_BREAKER_OPEN_DURATION_S=30.0

# ── Semantic cache ──────────────────────────────────────────────────────────
# Global switch. Each team must also set `semantic_cache: true` in teams.yaml.
GATEWAY_CACHE_ENABLED=false
# Embedding-similarity matching on top of exact matching. Off by default: run
# scripts/calibrate_cache.py on your own prompts first (docs/cache.md).
GATEWAY_CACHE_SEMANTIC_ENABLED=false
GATEWAY_CACHE_SIMILARITY_THRESHOLD=0.92
GATEWAY_CACHE_TTL_S=3600
GATEWAY_CACHE_MAX_ENTRIES_PER_PARTITION=1000
GATEWAY_CACHE_MAX_PARTITIONS=10000
# Requests above this temperature bypass the cache.
GATEWAY_CACHE_MAX_TEMPERATURE=0.0
# Instruction prepended to both prompts compared by the semantic cache (Qwen3-Embedding
# format); set empty for embedding models without instructions.
GATEWAY_CACHE_EMBEDDING_PREFIX="Instruct: Given a question, retrieve questions that are semantically equivalent to the given question\nQuery:"

# ── Routing (applies to requests with model="auto") ─────────────────────────
# static | autopilot
GATEWAY_ROUTING_POLICY=static
# llm-cost-autopilot sidecar (docker-compose.autopilot.yml publishes it on 8100).
GATEWAY_AUTOPILOT_BASE_URL=http://localhost:8100
# Bearer token, only if the sidecar sets AUTOPILOT_API_TOKEN.
GATEWAY_AUTOPILOT_API_TOKEN=
GATEWAY_AUTOPILOT_TIMEOUT_S=0.25
# Autopilot complexity tier -> gateway model tier (budget | high_quality).
GATEWAY_AUTOPILOT_TIER_SIMPLE=budget
GATEWAY_AUTOPILOT_TIER_MODERATE=high_quality

# ── Tracing (Prometheus metrics are always on at /metrics) ──────────────────
# One OTel GenAI span per LLM call, exported over OTLP/HTTP. The exporter reads
# the standard OTEL_* variables (OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_SERVICE_NAME,
# ...), which must be real environment variables: this file only feeds GATEWAY_*.
GATEWAY_TRACING_ENABLED=false
# Records prompts and answers on the spans (gen_ai.input.messages /
# gen_ai.output.messages). May contain personal data; off by default.
GATEWAY_TRACING_CAPTURE_MESSAGE_CONTENT=false
