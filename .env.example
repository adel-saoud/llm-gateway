# ── Server ──────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# ── Ollama ──────────────────────────────────────────────────────────────────
# When running on the host, http://localhost:11434
# Inside docker-compose, the service hostname is `ollama`.
GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
GATEWAY_OLLAMA_TIMEOUT_S=120.0

# Model identifiers exposed to callers.
GATEWAY_MODEL_HIGH_QUALITY=llama3.2:3b
GATEWAY_MODEL_BUDGET=qwen2.5:0.5b
GATEWAY_MODEL_EMBEDDINGS=nomic-embed-text

# ── Redis (token bucket rate limiting) ──────────────────────────────────────
GATEWAY_REDIS_URL=redis://localhost:6379/0

# ── SQLite (cost ledger, circuit state, request log) ────────────────────────
# Relative to cwd. Override with an absolute path for production.
GATEWAY_DB_PATH=data/gateway.db

# ── Auth ────────────────────────────────────────────────────────────────────
# Path to the YAML file of teams (see auth/teams.example.yaml). Hot-reloaded
# on PUT /v1/admin/teams/{id}.
GATEWAY_TEAMS_YAML=config/teams.yaml

# ── Circuit breaker ─────────────────────────────────────────────────────────
GATEWAY_CB_FAILURE_RATE_THRESHOLD=0.5
GATEWAY_CB_MIN_REQUESTS=10
GATEWAY_CB_OPEN_DURATION_S=30.0

# ── Observability ───────────────────────────────────────────────────────────
GATEWAY_METRICS_ENABLED=true
GATEWAY_TRACING_ENABLED=false
