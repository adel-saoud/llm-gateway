meta {
  name: Update Allowed Models
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/admin/teams/customer-support
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminApiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "allowed_models": ["budget", "embeddings", "high_quality"]
  }
}

docs {
  Adds the high_quality tier to the customer-support team's whitelist.

  By default the customer-support team is restricted to the budget and
  embeddings tiers (see config/teams.example.yaml). Entries may be tiers or
  model ids; a tier follows the GATEWAY_MODEL_* settings.

  An empty array `[]` means no restriction: all registry models are allowed.
  Requests for models not in the whitelist receive 403 Forbidden.
}
