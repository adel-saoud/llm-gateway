meta {
  name: List Models
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Returns the full model catalogue with simulated cost tiers.

  Response fields per model:
  - `id`                    model identifier (e.g. "qwen3.5:4b")
  - `tier`                  "high_quality", "budget", or "embeddings"
  - `cost_per_1k_input_usd`: simulated input token price
  - `cost_per_1k_output_usd`  simulated output token price (0.0 for embed models)
  - `is_embedding_model`    true for qwen3-embedding:0.6b

  Default tiers:
  | Model                | Tier         | Input/1k  | Output/1k |
  |----------------------|--------------|-----------|-----------|
  | qwen3.5:4b           | high_quality | $0.003    | $0.015    |
  | qwen3.5:0.8b         | budget       | $0.0001   | $0.0002   |
  | qwen3-embedding:0.6b | embeddings   | $0.0001   | n/a       |
}
