meta {
  name: Generation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "{{qualityModel}}",
    "messages": [
      {
        "role": "system",
        "content": "Use the passages to answer the user's question concisely."
      },
      {
        "role": "user",
        "content": "Question: Which headphones have the best noise cancellation under $300?\nPassages:\n- Sony WH-1000XM5: 30-hour battery, noise cancellation, $299.\n- Bose QuietComfort 45: 24-hour battery, adjustable ANC, $279.\n- Apple AirPods Pro (2nd gen): 6-hour battery (30h with case), $249."
      }
    ],
    "max_tokens": 256,
    "temperature": 0.0
  }
}

docs {
  Sends a generation request using the high-quality model (qwen3.5:4b by default).

  The gateway automatically builds a two-candidate fallback chain:
  qwen3.5:4b → qwen3.5:0.8b. If the primary is unavailable or the circuit
  breaker is OPEN, the request falls back to the budget model transparently.

  Response headers:
  - `X-Gateway-Cost-USD`       cost of this specific request
  - `X-Gateway-Model-Used`     actual model that served it (may differ on fallback)
  - `X-Gateway-Rag-Operation`  classifier result (generation for this request)
}
